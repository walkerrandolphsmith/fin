{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@fin/email-sender": ["../email-sender/src"],
      "@fin/email-sender/*": ["../email-sender/src/*"],
      "@fin/email-sender-circuit-breaker": [
        "../email-sender-circuit-breaker/src"
      ],
      "@fin/email-sender-circuit-breaker/*": [
        "../email-sender-circuit-breaker/src/*"
      ],
      "@fin/email-sender-mailgun": ["../email-sender-mailgun/src"],
      "@fin/email-sender-mailgun/*": ["../email-sender-mailgun/src/*"],
      "@fin/email-sender-failover": ["../email-sender-failover/src"],
      "@fin/email-sender-failover/*": ["../email-sender-failover/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
